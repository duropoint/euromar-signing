# Documenso settings used by this deployment (render.yaml sets them on Render,
# deploy/docker-compose.yml sets them locally). Reference only - not loaded
# automatically. Full upstream list: https://github.com/documenso/documenso/blob/main/.env.example

# --- required ---------------------------------------------------------------
NEXT_PUBLIC_WEBAPP_URL=https://docu-euromar.onrender.com   # public URL (embed iframes load it)
NEXT_PRIVATE_INTERNAL_WEBAPP_URL=http://localhost:3000      # how the app reaches itself
PORT=3000
NEXT_PRIVATE_DATABASE_URL=postgres://user:pass@host:5432/documenso
NEXT_PRIVATE_DIRECT_DATABASE_URL=postgres://user:pass@host:5432/documenso
NEXTAUTH_SECRET=                          # random, 32+ chars
NEXT_PRIVATE_ENCRYPTION_KEY=              # random, 32+ chars - never change once set
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=    # random, 32+ chars - never change once set

# --- signing certificate ----------------------------------------------------
NEXT_PRIVATE_SIGNING_TRANSPORT=local
NEXT_PRIVATE_SIGNING_LOCAL_FILE_CONTENTS= # base64 of cert.p12  (or ..._LOCAL_FILE_PATH=/path/cert.p12)
NEXT_PRIVATE_SIGNING_PASSPHRASE=
NEXT_PRIVATE_SIGNING_REASON=Electronically signed via Euromar e-signing
NEXT_PRIVATE_SIGNING_TIMESTAMP_AUTHORITY= # optional, e.g. http://timestamp.digicert.com

# --- storage / jobs ---------------------------------------------------------
NEXT_PUBLIC_UPLOAD_TRANSPORT=database
NEXT_PUBLIC_DOCUMENT_SIZE_UPLOAD_LIMIT=20  # MB
NEXT_PRIVATE_JOBS_PROVIDER=local

# --- mail (admin account mails only) ----------------------------------------
NEXT_PRIVATE_SMTP_TRANSPORT=resend         # or smtp-auth (+ NEXT_PRIVATE_SMTP_HOST/PORT/USERNAME/PASSWORD)
NEXT_PRIVATE_RESEND_API_KEY=
NEXT_PRIVATE_SMTP_FROM_NAME=Euromar e-signing
NEXT_PRIVATE_SMTP_FROM_ADDRESS=signing@email.eu-registry.com

# --- hardening --------------------------------------------------------------
NEXT_PUBLIC_DISABLE_SIGNUP=true            # "false" only while creating the first admin
DOCUMENSO_DISABLE_TELEMETRY=true
# NEXT_PRIVATE_WEBHOOK_SSRF_BYPASS_HOSTS=  # only for webhooks to private hosts (local dev)
